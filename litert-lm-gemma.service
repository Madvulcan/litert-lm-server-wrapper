[Unit]
Description=LiteRT-LM server — Gemma 4 (E2B/E4B, auto-detect)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/home/madvulcan/.local/share/uv/tools/litert-lm/bin/python3 /home/madvulcan/llama-cpp-server/litert-lm-server.py --mode server --port 11454 --model-size 4b
ExecStartPost=/bin/sh -c 'echo "LiteRT-LM server started with model-size=2b. Use --model-size 4b for the larger model."'
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=60
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/madvulcan"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
StandardOutput=append:/tmp/litert-lm.log
StandardError=append:/tmp/litert-lm.log
KillSignal=SIGTERM
KillMode=process
# GPU access
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/dri/* rw

[Install]
WantedBy=default.target
